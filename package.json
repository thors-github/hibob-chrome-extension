{
  "name": "hibob-monatsbuchung",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run i18n:check && node scripts/third-party-notices.mjs && vite build && node scripts/package.mjs",
    "check": "npm run test && npm run build && npm run test:e2e",
    "holidays:update": "node scripts/generate-holidays.mjs",
    "icons:update": "node scripts/generate-icons.mjs",
    "i18n:check": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "date-holidays-parser": "^3.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.1.28",
    "@types/node": "^24.10.0",
    "date-holidays": "^3.38.0",
    "esbuild": "^0.25.12",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
